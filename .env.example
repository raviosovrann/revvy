# =============================================================================
# Revvy Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values for local development.
# NEVER commit .env files with real secrets to version control.
# =============================================================================

# Application
NODE_ENV=development
API_BASE_URL=http://localhost:3000/api/v1

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/revvy?schema=public
DIRECT_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/revvy?schema=public

# Authentication (Supabase Auth)
AUTH_PROVIDER_URL=https://your-project.supabase.co
AUTH_PROVIDER_PUBLIC_KEY=your-supabase-anon-key
AUTH_PROVIDER_SECRET_KEY=your-supabase-service-role-key

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_CONNECT_CLIENT_ID=ca_...

# Twilio (SMS)
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_FROM_NUMBER=+1234567890

# Email (Resend or Postmark)
EMAIL_PROVIDER_API_KEY=re_...

# Object Storage (S3/R2/Supabase Storage)
OBJECT_STORAGE_ENDPOINT=https://your-storage-endpoint
OBJECT_STORAGE_BUCKET=revvy-media
OBJECT_STORAGE_ACCESS_KEY=your-access-key
OBJECT_STORAGE_SECRET_KEY=your-secret-key

# Redis (optional for V1)
REDIS_URL=redis://localhost:6379

# Observability
SENTRY_DSN=https://your-sentry-dsn
POSTHOG_API_KEY=phc_...

# Mobile (Expo)
EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1
EXPO_PUBLIC_AUTH_PROVIDER_KEY=your-supabase-anon-key
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
