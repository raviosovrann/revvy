{
  "name": "revvy",
  "version": "0.1.0",
  "private": true,
  "description": "Revvy - Mobile-first platform for independent auto-service businesses",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "clean": "turbo run clean",
    "db:generate": "pnpm --filter @revvy/api exec prisma generate",
    "db:migrate": "pnpm --filter @revvy/api exec prisma migrate dev",
    "db:push": "pnpm --filter @revvy/api exec prisma db push",
    "db:seed": "pnpm --filter @revvy/api exec prisma db seed",
    "db:studio": "pnpm --filter @revvy/api exec prisma studio",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\""
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "turbo": "^2.1.0",
    "typescript": "^5.5.4"
  },
  "packageManager": "pnpm@9.7.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
